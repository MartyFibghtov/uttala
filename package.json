{
  "name": "sayclear",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node scripts/start-standalone.mjs",
    "lint": "eslint",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "stripe:setup": "node scripts/stripe-setup.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "calibrate": "npx -y tsx --tsconfig tsconfig.json scripts/calibrate.mts",
    "realset": "npx -y tsx --tsconfig tsconfig.json scripts/realset.mts",
    "phonecheck": "npx -y tsx --tsconfig tsconfig.json scripts/phonecheck.mts",
    "gopcheck": "npx -y tsx --tsconfig tsconfig.json scripts/gopcheck.mts",
    "tune-deductions": "npx -y tsx --tsconfig tsconfig.json scripts/tune-deductions.mts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@libsql/client": "^0.18.0",
    "@libsql/kysely-libsql": "^0.4.1",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "kysely": "^0.29.8",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "stripe": "^23.1.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.6.0"
}
