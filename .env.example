# ---- Required -----------------------------------------------------------------

# Reference voices, transcription and alignment (elevenlabs.io > API keys)
ELEVENLABS_API_KEY=

# Personalized weak-spot text generation and multimodal phonetic diagnosis (platform.openai.com)
OPENAI_API_KEY=

# Session signing secret: `openssl rand -hex 32`
BETTER_AUTH_SECRET=
# Public address of the site, no trailing slash
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Database -----------------------------------------------------------------
# Leave unset in development to use a local file (.data/uttala.db).
# In production use a hosted libSQL database, e.g. Turso: libsql://<name>.turso.io
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=

# ---- Payments (Stripe) ----------------------------------------------------------
# Prefer a restricted key (rk_...) with write access to Checkout Sessions,
# Customers, Subscriptions, Billing Portal, and read access to Prices and Charges.
# Without these, every feature is unlocked and nothing is sold.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PORTAL_CONFIGURATION=
# Only after registering for tax in Stripe Tax:
# STRIPE_AUTOMATIC_TAX=true

# ---- Optional -----------------------------------------------------------------

# Tailored practice text generation targeting a learner's weak words, sounds and contrasts (platform.openai.com)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Sound-by-sound scoring for the Pro plan (Azure Speech). Without it, Pro is not offered.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# Password-reset emails (resend.com). Without it, reset links are only written to the server log.
# RESEND_API_KEY=
# EMAIL_FROM="Uttala <hello@your-domain>"

# Practice reminder emails. A scheduler calls GET /api/cron/reminders once a day with
# "Authorization: Bearer <CRON_SECRET>" (Vercel Cron does this by itself; see vercel.json).
# Needs RESEND_API_KEY too. Without the secret the job is switched off.
# CRON_SECRET=

# "Continue with Google"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Shown in the footer and legal pages
# NEXT_PUBLIC_COMPANY_NAME=
# NEXT_PUBLIC_CONTACT_EMAIL=

# Model overrides
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v2
