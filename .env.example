# ---- Required -----------------------------------------------------------------

# Reference voices, transcription and alignment (elevenlabs.io > API keys)
ELEVENLABS_API_KEY=

# Personalized weak-spot text generation and multimodal phonetic diagnosis (platform.openai.com)
OPENAI_API_KEY=

# Session signing secret: `openssl rand -hex 32`
BETTER_AUTH_SECRET=
# Public address of the site, no trailing slash
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Database -----------------------------------------------------------------
# Leave unset in development to use a local file (.data/sayclear.db).
# In production use a hosted libSQL database, e.g. Turso: libsql://<name>.turso.io,
# or a file on a persistent volume: set DATA_DIR (Railway sets RAILWAY_VOLUME_MOUNT_PATH itself),
# which gives file:<dir>/sayclear.db.
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=

# ---- Payments (Stripe) ----------------------------------------------------------
# Prefer a restricted key (rk_...) with write access to Checkout Sessions,
# Customers, Subscriptions, Billing Portal, and read access to Prices and Charges.
# Without these, every feature is unlocked and nothing is sold.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PORTAL_CONFIGURATION=
# Only after registering for tax in Stripe Tax:
# STRIPE_AUTOMATIC_TAX=true
# Opt in to Stripe Adaptive Pricing (leave unset: prices already carry USD, SEK and EUR):
# STRIPE_ADAPTIVE_PRICING=true
# Test only: point the Stripe client at a local mock server (inert when unset):
# STRIPE_API_BASE=http://127.0.0.1:12111

# ---- Optional -----------------------------------------------------------------

# Tailored practice text generation targeting a learner's weak words, sounds and contrasts (platform.openai.com)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Sound-by-sound scoring for the Pro plan (Azure Speech). Without it, Pro is not offered.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# Password-reset emails (resend.com). Without it, reset links are only written to the server log.
# RESEND_API_KEY=
# EMAIL_FROM="SayClear <hello@your-domain>"

# Practice reminder emails. A scheduler calls GET /api/cron/reminders once a day with
# "Authorization: Bearer <CRON_SECRET>" (a Railway cron service; see docs/deploy-railway.md).
# Needs RESEND_API_KEY too. Without the secret the job is switched off.
# CRON_SECRET=

# "Continue with Google"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Shown in the footer and legal pages
# NEXT_PUBLIC_COMPANY_NAME=
# NEXT_PUBLIC_CONTACT_EMAIL=

# Model overrides
# ELEVENLABS_TTS_MODEL=eleven_v4
# ELEVENLABS_STT_MODEL=scribe_v2

# ---- Deployment (Railway) -----------------------------------------------------
# Full guide: docs/deploy-railway.md. Set these as service variables in Railway.
# BETTER_AUTH_URL=https://your-domain
# NEXT_PUBLIC_SITE_URL=https://your-domain      # inlined at build time: change it, then redeploy
# DATA_DIR=/data                                # optional; RAILWAY_VOLUME_MOUNT_PATH is used when a volume is attached
# CRON_SECRET=                                  # also set on the cron service
# SOUND_MODEL_DIR=/app/models                   # set by the Dockerfile; elsewhere defaults to .data/models (downloaded on first use)
# SOUND_MODEL_CONCURRENCY=1
# Healthcheck path in Railway: /api/health
